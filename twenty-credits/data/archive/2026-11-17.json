      "publishedAt": "2026-11-17T20:04:27+09:00",
      "url": "https://note.com/m_100tone/n/n2f56e7074112"
    },
    {
      "key": "nf6509ca05d63",
      "text": "ズルいよ、いつだって でも、スキなんだろ？",
      "charCount": 20,
      "authorName": "Blue Rose 55",
      "handle": "clean_auklet416",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "ゲームオーバー｜20字小説　シロクマ文芸部",

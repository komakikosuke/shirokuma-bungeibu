      "handle": "yomosugararip",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "遠距離親愛【20字小説】",
      "publishedAt": "2026-11-17T20:00:51+09:00",
      "url": "https://note.com/yomosugararip/n/n616474c1bc33"
    },
    {
      "key": "n26132648efb2",
      "text": "君の寝顔は、今日の反省会と明日の原動力。",
      "charCount": 20,
      "authorName": "ganbarusyufuyade",
      "handle": "ganbarusyufuyade",
      "creditGroup": "club",
      "sourceType": "extracted",

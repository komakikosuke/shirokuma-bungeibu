      "publishedAt": "2026-11-17T20:11:17+09:00",
      "url": "https://note.com/sane_gnu4460/n/n38bbffa2895e"
    },
    {
      "key": "n21190dddbeb8",
      "text": "カッコ悪いというけどそういう君は何なの。",
      "charCount": 20,
      "authorName": "ツムジ",
      "handle": "west4h",
      "creditGroup": "club",

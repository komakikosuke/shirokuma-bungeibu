    },
    {
      "key": "n3d26a8beedbc",
      "text": "でも、連れてって！氷雨にしっぽワイパー。",
      "charCount": 20,
      "authorName": "豆島  圭",
      "handle": "lucky_omame",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説　no title①",
      "publishedAt": "2026-11-17T20:12:14+09:00",
      "url": "https://note.com/lucky_omame/n/n3d26a8beedbc"
    },
    {
      "key": "n333846b7023d",
      "text": "目覚めると死体が消えていた。犯人は誰だ？",
      "charCount": 20,
      "authorName": "ねこ",
      "handle": "engwdeslp",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "【20字小説】犯人は誰だ",
      "publishedAt": "2026-11-17T20:13:24+09:00",
      "url": "https://note.com/engwdeslp/n/n333846b7023d"
    },
    {
      "key": "n66b271fe47ef",
      "text": "あの日私は左へ進んだ、右の車線なら事故。",
      "charCount": 20,
      "authorName": "紬（つむぎ）",
      "handle": "tsumugi_memories",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説",
      "publishedAt": "2026-11-17T20:13:39+09:00",
      "url": "https://note.com/tsumugi_memories/n/n66b271fe47ef"
    },
    {
      "key": "nc3b0a76b26c0",
      "text": "地獄の釜の前で祈る。来世は蟹以外がいい。",
      "charCount": 20,
      "authorName": "もりおん",
      "handle": "morion_202609",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説/祈り",
      "publishedAt": "2026-11-17T20:14:02+09:00",
      "url": "https://note.com/morion_202609/n/nc3b0a76b26c0"
    },
    {
      "key": "ne39959da9882",
      "text": "教科書が英語って、うちら古典学科やで？",
      "charCount": 19,
      "authorName": "数理落語家　自然対数乃亭吟遊",
      "handle": "agawa_shou",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "【20字小説】　『進学』",
      "publishedAt": "2026-11-17T20:14:28+09:00",
      "url": "https://note.com/agawa_shou/n/ne39959da9882"
    },
    {
      "key": "n8ccc11237b20",
      "text": "優しくなれない日。それでも猫にだけ開く懐",
      "charCount": 20,
      "authorName": "渡鳥",
      "handle": "joyous_panda989",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "シロクマ文芸部/20字小説",
      "publishedAt": "2026-11-17T20:15:03+09:00",
      "url": "https://note.com/joyous_panda989/n/n8ccc11237b20"
    },
    {
      "key": "n69b5edec84c7",
      "text": "あれ準備していたはずなのに間に合わない。",
      "charCount": 20,
      "authorName": "おすし",
      "handle": "uuuuu_sui",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説|【5分前待機の罠】シロクマ文芸部",
      "publishedAt": "2026-11-17T20:16:37+09:00",
      "url": "https://note.com/uuuuu_sui/n/n69b5edec84c7"
    },
    {
      "key": "nfa639ba0109d",
      "text": "まさか２０字小説を書くことになるなんて。",
      "charCount": 20,
      "authorName": "ヒラク∞",
      "handle": "at_hiraku",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "ある『２０字小説』の記録",
      "publishedAt": "2026-11-17T20:16:57+09:00",
      "url": "https://note.com/at_hiraku/n/nfa639ba0109d"
    },
    {
      "key": "n39bfd0cbf3e0",
      "text": "やれやれ。上目遣いと垂れ耳には連敗の僕。",
      "charCount": 20,
      "authorName": "豆島  圭",
      "handle": "lucky_omame",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説　no title②",
      "publishedAt": "2026-11-17T20:17:43+09:00",
      "url": "https://note.com/lucky_omame/n/n39bfd0cbf3e0"
    },
    {
      "key": "nbf0c059884ab",
      "text": "深い足跡は、玄関の前で引き返していた。",
      "charCount": 19,
      "authorName": "マイルドリリー",
      "handle": "mild_lily825",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "招かせない客　#シロクマ文芸部",
      "publishedAt": "2026-11-17T20:17:43+09:00",
      "url": "https://note.com/mild_lily825/n/nbf0c059884ab"
    },
    {
      "key": "n87ed6cd91ac5",
      "text": "父大好き！カリカリにささ身のせ。給料日？",
      "charCount": 20,
      "authorName": "豆島  圭",
      "handle": "lucky_omame",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説　no title③",
      "publishedAt": "2026-11-17T20:20:47+09:00",
      "url": "https://note.com/lucky_omame/n/n87ed6cd91ac5"
    },
    {
      "key": "ne71dd9f576a8",
      "text": "君が帰らないからまた私は時計を見てる。",
      "charCount": 19,
      "authorName": "橘 ゆず",
      "handle": "yuzu343",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "深夜のリビング。/#20字小説",
      "publishedAt": "2026-11-17T20:21:22+09:00",
      "url": "https://note.com/yuzu343/n/ne71dd9f576a8"
    },
    {
      "key": "n59f135e3ad47",
      "text": "何歳になっても、誰かのこどもで誰かの親。",
      "charCount": 20,
      "authorName": "リバ剣女子over60",
      "handle": "hot_puma4983",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "newアカウントではじめまして",
      "publishedAt": "2026-11-17T20:25:11+09:00",
      "url": "https://note.com/hot_puma4983/n/n59f135e3ad47"
    },
    {
      "key": "nc89d94004c2a",
      "text": "禿げ頭に若毛が居たり 大事にせねばならぬ。",
      "charCount": 20,
      "authorName": "ボーン",
      "handle": "yagami12345",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "#20字小説　わかげのいたり",
      "publishedAt": "2026-11-17T20:25:19+09:00",
      "url": "https://note.com/yagami12345/n/nc89d94004c2a",
      "sourceLines": [
        "禿げ頭に若毛が居たり",
        "大事にせねばならぬ。"
      ]
    },
    {
      "key": "n986d36b14319",
      "text": "明治以外のチョコを買ったら追い出された。",
      "charCount": 20,
      "authorName": "佐藤りぷ",
      "handle": "gay_curlew1055",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "涙　#20字小説",
      "publishedAt": "2026-11-17T20:25:28+09:00",
      "url": "https://note.com/gay_curlew1055/n/n986d36b14319"
    },
    {
      "key": "nf695168b814a",
      "text": "嘘じみた晴天。まだ温かい。まだ信じない。",
      "charCount": 20,
      "authorName": "豆島  圭",
      "handle": "lucky_omame",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説　no title④",
      "publishedAt": "2026-11-17T20:27:26+09:00",
      "url": "https://note.com/lucky_omame/n/nf695168b814a"
    },
    {
      "key": "n24e13c3913be",
      "text": "２０、１９、１８、１７、１６、１５、１。",
      "charCount": 20,
      "authorName": "ポールミセス",
      "handle": "serene_yarrow436",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説｜カウントダウン",
      "publishedAt": "2026-11-17T20:27:27+09:00",
      "url": "https://note.com/serene_yarrow436/n/n24e13c3913be"
    },
    {
      "key": "n5ffd4a9349bb",
      "text": "雨にも負けず風にも負けず だが嫁には負ける",
      "charCount": 20,
      "authorName": "ボーン",
      "handle": "yagami12345",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "丈夫な男#20字の小説",
      "publishedAt": "2026-11-17T20:27:38+09:00",
      "url": "https://note.com/yagami12345/n/n5ffd4a9349bb",
      "sourceLines": [
        "雨にも負けず風にも負けず",
        "だが嫁には負ける"
      ]
    },
    {
      "key": "n9a43c00e2e1b",
      "text": "駐車場横の空き地の主は今日も惰眠を愛す。",
      "charCount": 20,
      "authorName": "りみっと",
      "handle": "limit3",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "【20字小説】野良猫｜＃シロクマ文芸部",
      "publishedAt": "2026-11-17T20:27:43+09:00",
      "url": "https://note.com/limit3/n/n9a43c00e2e1b"
    },
    {
      "key": "nde9a8d9652b7",
      "text": "誰にも知られていないことだけ知っている。",
      "charCount": 20,
      "authorName": "つつ",
      "handle": "joyous_worm3932",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説｜座右の無名  #シロクマ文芸部",
      "publishedAt": "2026-11-17T20:29:58+09:00",
      "url": "https://note.com/joyous_worm3932/n/nde9a8d9652b7"
    },
    {
      "key": "ncfd0d7f97fb9",
      "text": "懐かしいなぁ、と思う自分が、もうお年頃。",
      "charCount": 20,
      "authorName": "紬（つむぎ）",
      "handle": "tsumugi_memories",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説",
      "publishedAt": "2026-11-17T20:32:19+09:00",
      "url": "https://note.com/tsumugi_memories/n/ncfd0d7f97fb9"
    },
    {
      "key": "ne10bf4a6077e",
      "text": "「寒いね」といつまで歩く素足のリビング。",
      "charCount": 20,
      "authorName": "望月むう（ムーン）🐾｜物語と思考｜物語に浸りたい",
      "handle": "mfullmoon001",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "シロクマ文芸部🐻‍❄️「#20字小説」｜靴下がきらいな人",
      "publishedAt": "2026-11-17T20:33:04+09:00",
      "url": "https://note.com/mfullmoon001/n/ne10bf4a6077e"
    },
    {
      "key": "nad5f76bcd5ad",
      "text": "秋と本、いい組み合わせ 飽きた本、私の小説",
      "charCount": 20,
      "authorName": "ボーン",
      "handle": "yagami12345",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "読書の秋(20字の小説)",
      "publishedAt": "2026-11-17T20:34:10+09:00",
      "url": "https://note.com/yagami12345/n/nad5f76bcd5ad",
      "sourceLines": [
        "秋と本、いい組み合わせ",
        "飽きた本、私の小説"
      ]
    },
    {
      "key": "n05e83380e557",
      "text": "帰ってくる場所になりたい、そういう話。",
      "charCount": 19,
      "authorName": "にこゆ",
      "handle": "nico_yu",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "【20字小説】来世も恋物語",
      "publishedAt": "2026-11-17T20:34:39+09:00",
      "url": "https://note.com/nico_yu/n/n05e83380e557"
    },
    {
      "key": "nfe980688d8a4",
      "text": "天上天我唯我独尊 恐れるなかれ 好奇心で進め",
      "charCount": 20,
      "authorName": "ふわり日和｜当たり前に「頑張る」あなたへ",
      "handle": "dear_dahlia6678",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "どうせ創造世界なら ┊︎ 20字小説",
      "publishedAt": "2026-11-17T20:38:57+09:00",
      "url": "https://note.com/dear_dahlia6678/n/nfe980688d8a4",
      "sourceLines": [
        "天上天我唯我独尊",
        "恐れるなかれ",
        "好奇心で進め"
      ]
    },
    {
      "key": "neea05fb642b4",
      "text": "三日月を見て懐かしむ、アントニオ猪木の妻",
      "charCount": 20,
      "authorName": "ボーン",
      "handle": "yagami12345",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "想い出　#20字小説",
      "publishedAt": "2026-11-17T20:39:34+09:00",
      "url": "https://note.com/yagami12345/n/neea05fb642b4"
    },
    {
      "key": "n6745905b0816",
      "text": "またね、と手を振った。また会えるように。",
      "charCount": 20,
      "authorName": "土俵際のラッコ",
      "handle": "racco_17",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "またね｜20字小説",
      "publishedAt": "2026-11-17T20:39:49+09:00",
      "url": "https://note.com/racco_17/n/n6745905b0816"
    },
    {
      "key": "nba9a5ea7afdf",
      "text": "明日に絶望し、現実を見ないよう目を瞑る。",
      "charCount": 20,
      "authorName": "山羊",
      "handle": "clever_yagi2000",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説/1日の終わり",
      "publishedAt": "2026-11-17T20:50:15+09:00",
      "url": "https://note.com/clever_yagi2000/n/nba9a5ea7afdf"
    },
    {
      "key": "n2f6a01b88b85",
      "text": "大盛りの醤油ラーメン、心も満たされた夜。",
      "charCount": 20,
      "authorName": "明石勇作",
      "handle": "easy_sorrel824",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "[20字小説] 晩御飯｜シロクマ文芸部",
      "publishedAt": "2026-11-17T20:50:27+09:00",
      "url": "https://note.com/easy_sorrel824/n/n2f6a01b88b85"
    },
    {
      "key": "n7f086d2cf451",
      "text": "私の才能をどの様に表現したら良いのだろう",
      "charCount": 20,
      "authorName": "ボーン",
      "handle": "yagami12345",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "見つからない言葉#20字小説",
      "publishedAt": "2026-11-17T20:50:57+09:00",
      "url": "https://note.com/yagami12345/n/n7f086d2cf451"
    },
    {
      "key": "n6bb0447c9692",
      "text": "愛しのロブ、あなたがボンドになるなんて！",
      "charCount": 20,
      "authorName": "くまのマフィン",
      "handle": "mu25",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "20字小説｜Dear Rob,",
      "publishedAt": "2026-11-17T20:54:28+09:00",
      "url": "https://note.com/mu25/n/n6bb0447c9692"
    },
    {
      "key": "n213109a2c894",
      "text": "パンダのダン・パを冷めた目で見つめる私。",
      "charCount": 20,
      "authorName": "藍玉カトルセ",
      "handle": "sparkle_memory",
      "creditGroup": "club",
      "sourceType": "extracted",
      "title": "【20字小説】パンダのダン・パ",
      "publishedAt": "2026-11-17T20:55:18+09:00",
      "url": "https://note.com/sparkle_memory/n/n213109a2c894"
    }

      "url": "https://note.com/sourcilkotori/n/n192427ca512a"
    },
    {
      "key": "n1c1ebf53fc75",
      "text": "小さな物語がたくさん生まれる不思議な夜。",
      "charCount": 20,
      "authorName": "❁ Ordeal ❁",
      "handle": "brainy_elk1055",
      "creditGroup": "club",
